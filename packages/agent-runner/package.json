{
  "name": "@openreel/agent-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "openreel-agent": "dist/cli.cjs"
  },

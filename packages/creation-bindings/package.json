{
  "name": "@openreel/creation-bindings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node addon / WASM bindings for @openreel/creation-core with a CPU fallback to @openreel/core/creation.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@openreel/core": "workspace:*"
  }
}

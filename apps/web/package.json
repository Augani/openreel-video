{
  "name": "@openreel/web",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "wrangler pages deploy dist --project-name=openreel",
    "deploy:preview": "wrangler pages deploy dist --project-name=openreel --branch=preview",
    "test": "vitest",
    "test:run": "vitest run",
    "perf:gate": "vitest run performance",
    "bundle:budget": "node scripts/check-bundle-size.mjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:soak": "node scripts/soak.mjs",
    "test:memory-gate": "node scripts/soak.mjs memory-4k-layered.spec.ts",
    "test:memory-gate:long": "SOAK_4K_SECONDS=600 SOAK_4K_PROXY=0 SOAK_4K_PLAY_FROM=100 node scripts/soak.mjs memory-4k-layered.spec.ts",
    "test:e2e:prod": "node scripts/e2e-prod.mjs",
    "clean": "rm -rf dist node_modules/.vite && find src -name '*.js' -o -name '*.js.map' -o -name '*.d.ts' -o -name '*.d.ts.map' | xargs rm -f 2>/dev/null || true"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@openreel/agent": "workspace:*",
    "@openreel/collab": "workspace:*",
    "@openreel/core": "workspace:*",
    "@openreel/ui": "workspace:*",
    "@types/react-syntax-highlighter": "^15.5.13",
    "brotli-dec-wasm": "2.3.2",
    "framer-motion": "^12.23.24",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.555.0",
    "posthog-js": "^1.335.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.182.0",
    "uuid": "^13.0.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fake-indexeddb": "6.2.5",
    "globals": "^17.0.0",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vitest": "^1.6.0",
    "wrangler": "^3.114.17"
  }
}

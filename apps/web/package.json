{
  "name": "@openreel/web",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "wrangler pages deploy dist --project-name=openreel",
    "deploy:preview": "wrangler pages deploy dist --project-name=openreel --branch=preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules/.vite && find src -name '*.js' -o -name '*.js.map' -o -name '*.d.ts' -o -name '*.d.ts.map' | xargs rm -f 2>/dev/null || true"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.1.1",
    "@astryxdesign/theme-neutral": "^0.1.1",
    "@gsap/react": "^2.1.2",
    "@openreel/agent": "workspace:*",
    "@openreel/core": "workspace:*",
    "@openreel/ui": "workspace:*",
    "@paper-design/shaders-react": "^0.0.76",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/uuid": "^11.0.0",
    "framer-motion": "^12.23.24",
    "gsap": "^3.14.2",
    "i18next": "^26.3.6",
    "lucide-react": "^0.555.0",
    "posthog-js": "^1.335.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.11",
    "react-syntax-highlighter": "^16.1.0",
    "three": "^0.182.0",
    "uuid": "^13.0.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fast-check": "^3.19.0",
    "globals": "^17.0.0",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vitest": "^1.6.0",
    "wrangler": "^3.114.17"
  }
}

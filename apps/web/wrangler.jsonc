{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openreel",
  "compatibility_date": "2024-01-01",
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/proxy",
      "/api/proxy/*"
    ]
  },
  "main": "./.worker/index.js"
}

# PostHog Analytics (optional)
# Get your keys at https://posthog.com
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=

# controls which hostnames Vite will accept requests from
# default: localhost, *.localhost, and all IP addresses are allowed
# ".example.com" -> allows example.com and any subdomain (foo.example.com, a.b.example.com)
# true -> allows any hostname (not recommended, DNS rebinding risk)
# note: HTTPS bypasses this host check entirely
VITE_ALLOWED_HOSTS=

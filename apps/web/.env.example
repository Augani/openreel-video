# PostHog Analytics (optional)
# Get your keys at https://posthog.com
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=

# Browser editor AI agent defaults (optional)
# NOTE: VITE_ vars are bundled into client code. Only put an API key here for local/private builds.
# In dev, requests to VITE_AI_BASE_URL go through a Vite proxy (/__ai-proxy), so gateways without CORS headers work.
# Provider: openai | anthropic | compatible
VITE_AI_PROVIDER=
VITE_AI_API_KEY=
# Defaults per provider: openai https://api.openai.com/v1, anthropic https://api.anthropic.com/v1, compatible http://localhost:1234/v1
VITE_AI_BASE_URL=
VITE_AI_MODEL=

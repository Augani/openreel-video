{
  "name": "@openreel/desktop",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "main": "dist/main/index.js",
  "bin": {
    "openreel-mcp": "dist/mcp-shim/index.js"
  },
  "homepage": "https://openreel.video",
  "author": {
    "name": "OpenReel",
    "email": "support@openreel.video"
  },
  "description": "OpenReel — open-source professional video editor",
  "scripts": {
    "build:main": "node scripts/prepare-aurora-native.mjs && tsup",
    "build:renderer": "OPENREEL_DESKTOP=1 pnpm --filter @openreel/web build",
    "build": "pnpm run build:renderer && pnpm run build:main",
    "predev": "pnpm run build:renderer",
    "dev": "tsup --watch --onSuccess \"electron .\"",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ingest-e2e": "OPENREEL_DESKTOP_E2E=1 vitest run test/ingest-electron.test.ts",
    "test:prores-e2e": "OPENREEL_DESKTOP_PRORES_E2E=1 vitest run test/prores-native-decode-electron.test.ts",
    "test:hdr-e2e": "OPENREEL_DESKTOP_HDR_E2E=1 vitest run test/hdr-export-electron.test.ts",
    "test:desktop-e2e": "OPENREEL_DESKTOP_E2E_PROJECT=1 vitest run test/desktop-project-e2e.electron.test.ts",
    "test:pro-media-e2e": "OPENREEL_DESKTOP_PRO_E2E=1 vitest run test/pro-media-e2e.electron.test.ts",
    "test:onboarding-e2e": "OPENREEL_DESKTOP_ONBOARDING_E2E=1 vitest run test/onboarding-first-run.electron.test.ts test/onboarding-automation.electron.test.ts test/onboarding-skip-persist.electron.test.ts test/onboarding-agent-flip.electron.test.ts",
    "test:soak-e2e": "OPENREEL_DESKTOP_SOAK=1 vitest run test/soak-electron.test.ts",
    "test:electron": "OPENREEL_ELECTRON_TEST=1 vitest run test/mcp-early-request.electron.test.ts",
    "test:mcp-windowless-e2e": "OPENREEL_DESKTOP_MCP_E2E=1 vitest run test/mcp-windowless-e2e.electron.test.ts",
    "perf": "node scripts/perf-harness.mjs",
    "perf:budget": "node scripts/perf-budget.mjs",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "prepare:aurora": "node scripts/prepare-aurora-native.mjs",
    "pack": "pnpm run fetch:ffmpeg && pnpm run build && electron-builder --dir",
    "dist": "pnpm run fetch:ffmpeg && pnpm run build && electron-builder",
    "test:watch-e2e": "OPENREEL_DESKTOP_WATCH_E2E=1 vitest run test/watch-folders-electron.test.ts test/watch-folders-project-electron.test.ts"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "tsup": "^8.0.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
